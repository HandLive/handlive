# Copy to .env (gitignored) and adjust. Values below are dev placeholders only.
DATABASE_URL=postgres://handlive:handlive-dev@127.0.0.1:55432/handlive_relay
REDIS_URL=redis://127.0.0.1:56379
# HS256 signing key for device JWTs, at least 32 bytes. Generate a real one with:
#   openssl rand -base64 48
RELAY_JWT_SECRET=dev-only-placeholder-change-me-0123456789abcdef
RELAY_BIND=127.0.0.1:8080
RUST_LOG=info
