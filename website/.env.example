# Copied to .env by bin/setup.sh, which replaces every "generate" with a random value.
# .env is git-ignored: never commit real passwords.
SITE_URL=http://localhost:8080
HTTP_PORT=8080
WP_ENVIRONMENT_TYPE=local

DB_NAME=handlive
DB_USER=handlive
DB_PASSWORD=generate
DB_ROOT_PASSWORD=generate

ADMIN_USER=handlive-admin
ADMIN_PASSWORD=generate
ADMIN_EMAIL=webmaster@handlive.app
