{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handlive.app/schemas/v1/session-error.schema.json",
  "title": "HandLive — session/error (S→C)",
  "description": "00-common-specs 0.6.3 bước 2; CONN-01 API 6. Payload chưa mã hóa; S đóng kết nối ngay sau đó (0.8.3). min_protocol chỉ đi kèm UNSUPPORTED_VERSION.",
  "type": "object",
  "required": ["op", "data"],
  "additionalProperties": false,
  "properties": {
    "op": { "const": "error" },
    "data": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "allOf": [
            { "$ref": "error.schema.json#/$defs/code" },
            { "enum": ["AUTH_FAILED", "PAIR_UNKNOWN", "PAIR_REVOKED", "UNSUPPORTED_VERSION", "RATE_LIMITED"] }
          ]
        },
        "message": { "type": "string" },
        "min_protocol": {
          "$ref": "common.schema.json#/$defs/int32",
          "minimum": 1
        }
      },
      "if": {
        "properties": { "code": { "const": "UNSUPPORTED_VERSION" } }
      },
      "then": true,
      "else": {
        "not": { "required": ["min_protocol"] }
      }
    }
  }
}
