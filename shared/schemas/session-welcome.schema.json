{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handlive.app/schemas/v1/session-welcome.schema.json",
  "title": "HandLive — session/welcome (S→C)",
  "description": "00-common-specs 0.6.3 bước 2; CONN-01 API 5. Payload chưa mã hóa.",
  "type": "object",
  "required": ["op", "data"],
  "additionalProperties": false,
  "properties": {
    "op": { "const": "welcome" },
    "data": {
      "type": "object",
      "required": ["device_id", "eph", "nonce", "mac"],
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "description": "device_id của Android.",
          "$ref": "common.schema.json#/$defs/uuid-v8"
        },
        "eph": { "$ref": "common.schema.json#/$defs/b64u-32" },
        "nonce": { "$ref": "common.schema.json#/$defs/b64u-32" },
        "mac": {
          "description": "HMAC-SHA256(K_auth, T2).",
          "$ref": "common.schema.json#/$defs/b64u-32"
        }
      }
    }
  }
}
