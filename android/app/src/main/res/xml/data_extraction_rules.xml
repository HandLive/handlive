<?xml version="1.0" encoding="utf-8"?>
<!-- Không sao lưu hay chuyển thiết bị bất kỳ dữ liệu nào: khóa và cặp ghép nối gắn với Keystore của máy này (0.6.1). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
