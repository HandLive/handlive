# Các phần mã nguồn là kho git riêng (handlive-android, handlive-apple, handlive-relay, handlive-shared),
# clone cạnh nhau bằng tools/clone-parts.sh; kho hub này chỉ giữ tài liệu, kế hoạch và công cụ tài liệu.
/android/
/apple/
/relay/
/shared/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Secrets / config
.env
.env.*
# Bí mật Firebase cục bộ: không commit (tools/release/setup-fcm.zsh)
google-services.json
*-firebase-adminsdk-*.json

# Xuất tài liệu (tools/docs/build_design_html.py)
/build/

# Log cua tools/verify-phase7.sh
/.build-logs/

# Kho ".github" của org (hồ sơ, file cộng đồng mặc định) — clone vào đây bằng tools/workspace.sh clone
/.github-org/

# Python caches and cross-agent locks
__pycache__/
/.locks/

# Agent worktrees created by Claude Code
/.claude/worktrees/

# vbsec security scan output
vbsec-reports/
